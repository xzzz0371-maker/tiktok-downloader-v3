{
  "manifest_version": 3,
  "name": "TikTok/抖音下载器",
  "version": "4.0.0",
  "description": "TikTok/抖音无水印视频下载（本地拦截+深度解析+FetchHTML+下载进度+侧边栏+推荐页自动解析）· 全免费无限下载",
  "permissions": [
    "downloads",
    "storage",
    "tabs",
    "scripting",
    "contextMenus",
    "notifications",
    "webRequest",
    "sidePanel"
  ],
  "host_permissions": [
    "*://*.tiktok.com/*",
    "*://*.douyin.com/*",
    "*://*.tiktokcdn.com/*",
    "*://*.douyinvod.com/*",
    "*://*.douyinpic.com/*",
    "*://*.douyinstatic.com/*",
    "*://api.tikwm.com/*",
    "*://www.tikwm.com/*",
    "*://api.douyin.wtf/*",
    "*://api-social-sooty.vercel.app/*",
    "*://api.tikmate.app/*",
    "*://api.tiklydown.eu.org/*",
    "*://*.tiklydown.eu.org/*",
    "*://*.workers.dev/*",
    "*://tdownv4.sl-bjs.workers.dev/*",
    "*://api.tikwm.one/*",
    "*://www.tikwm.one/*",
    "*://api.tiklydown.top/*",
    "*://*.tiklydown.top/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.tiktok.com/*",
        "*://*.douyin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html#sidepanel"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "download-current-video": {
      "suggested_key": {
        "default": "Ctrl+Shift+D",
        "mac": "Command+Shift+D"
      },
      "description": "下载当前页面视频"
    }
  }
}
